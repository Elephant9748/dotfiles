# Default settings applied to all accounts
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
# logfile        ~/.config/mutt/msmtp.log

# Account 1: mnetwork
account        mnetwork
host           smtp.gmail.com
port           587
tls_starttls   on
from           melon.network25@gmail.com
user           melon.network25@gmail.com
passwordeval   "gpg -q -d ~/mails/mnetworkisync.gpg"

# Account 2: mango
account        mango
host           smtp.gmail.com
port           587
tls_starttls   on
from           adytamasurya@gmail.com
user           adytamasurya@gmail.com
passwordeval   "gpg -q -d ~/mails/mangoisync.gpg"

# Account 3: adyaol
account        adyaol
host           smtp.verizon.net
port           587
tls_starttls   on
from           adytama.surya@aol.com
user           adytama.surya@aol.com
passwordeval   "gpg -q -d ~/mails/adyaolisync.gpg"

account default : mango

