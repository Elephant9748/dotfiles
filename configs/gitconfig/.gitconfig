[user]
	name = @Elephant9748
	email = adytamasurya@proton.me
[credential]
	helper = store
[safe]
	directory = /mnt/e/VSProject/strip-metadata-python
[core]
	editor = nvim

[init]
	defaultBranch = main
[alias]
        a = add
        s = status
        cm = commit -m
        co = checkout
        lo = log --all --decorate --oneline -50 --graph
        lod = "log --all --pretty=format:'%C(#655e5c)[%ad] %C(Yellow)%h %C(auto)%(decorate:tag=,separator= ) %Creset%s %C(#366146)[%an]' --date=short -50 --graph"
        l = log
        r = rebase
        r2 = rebase -i HEAD~2
        r3 = rebase -i HEAD~3
        bs = restore --stage
        b = restore
        pc = push codeberg main
        pg = push github main
        
