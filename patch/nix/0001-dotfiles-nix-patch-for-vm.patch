diff --git a/nix/pkgs/lsend/nix/default.nix b/nix/pkgs/lsend/nix/default.nix
new file mode 100644
index 0000000..734260e
--- /dev/null
+++ b/nix/pkgs/lsend/nix/default.nix
@@ -0,0 +1,58 @@
+# nix-build -E 'with import <nixpkgs> {}; callPackage ./nix/default.nix {}'
+# with flake just: nix build . --impure
+
+# Guide:
+# https://github.com/NixOS/nixpkgs/blob/master/doc/languages-frameworks/rust.section.md
+
+{
+  lib,
+  fetchFromGitHub,
+  rustPlatform,
+  git,
+  stdenv,
+}:
+rustPlatform.buildRustPackage (finalAttrs: {
+  pname = "localsend";
+  version = "1.18.1";
+
+  src = fetchFromGitHub {
+    owner = "localsend";
+    repo = "localsend";
+    tag = "v${finalAttrs.version}";
+    hash = "sha256-uxMfO39U0cC7Svf8QL4WUJJowuwmTjChrZ4VOWcgb4E=";
+  };
+
+  # dontBuild = true;
+  # # buildPhase = ":";
+  # doCheck = false;
+  nativeBuildInputs = [ git ];
+
+  cargoHash = "sha256-khnrHc/88j+JG3sSKvNUsu6JcrM83zIt+W3tT7dz2Ac=";
+
+  buildPhase = ''
+        cargo build --release --workspace
+  '';
+  checkPhase = ''
+        echo ":: SKIP CARGO TEST"
+  '';
+  installPhase = ''
+        mkdir -p $out/{bin,lib}
+        install -Dm755 target/release/localsend-cli $out/bin/lsend
+        install -Dm755 target/release/server $out/bin/
+        install -Dm755 target/release/librust_lib_localsend_app.* $out/lib/
+  '';
+
+  meta = {
+    description = "localsend-cli";
+    homepage = "https://localsend.org/";
+    donationPage = "https://localsend.org/donate";
+    license = lib.licenses.mit;
+    maintainers = with lib.maintainers; [
+      sikmir
+      linsui
+      pandapip1
+    ];
+    mainProgram = "lsend";
+  };
+})
+
