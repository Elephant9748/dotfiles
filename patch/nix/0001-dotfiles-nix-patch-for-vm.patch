new file mode 100644
index 0000000..404662b
--- /dev/null
+++ b/nix/pkgs/lsend/aur/lsend-bin/PKGBUILD
@@ -0,0 +1,22 @@
+# Maintainer: Mango
+# Contributor: Mango
+# Contributor: Mango <adytamasurya@protonmail.com>
+
+pkgname=localsend-cli
+pkgver=1.18.0
+pkgrel=1
+pkgdesc='An open source cross-platform alternative to AirDrop'
+url=https://github.com/localsend/localsend
+arch=('x86_64')
+options=(!debug)
+source_x86_64=("${url}/releases/download/v${pkgver}/LocalSend-CLI-${pkgver}-linux-x86-64.tar.gz")
+sha256sums_x86_64=('d47fe4688b277f86c4af6ca924fdcbf88fe40c0ef909b69f609b2cb431d74174')
+
+prepare() {
+        tar -zxvf "LocalSend-CLI-${pkgver}-linux-x86-64.tar.gz"
+}
+
+package() {
+        install -Dm755 "$pkgname" "$pkgdir/usr/local/bin/$pkgname"
+        ln -sf "$pkgdir/usr/local/bin/$pkgname" "$pkgdir/usr/local/bin/lsend"
+}
