diff --git a/nix/pkgs/lsend/aur/lsend-git/PKGBUILD b/nix/pkgs/lsend/aur/lsend-git/PKGBUILD
new file mode 100644
index 0000000..776b325
--- /dev/null
+++ b/nix/pkgs/lsend/aur/lsend-git/PKGBUILD
@@ -0,0 +1,28 @@
+# Maintainer: Mango
+# Contributor: Mango
+# Contributor: Mango <adytamasurya@protonmail.com>
+
+pkgname=localsend-cli-git
+pkgver=1.18.1
+pkgrel=1
+pkgdesc='An open source cross-platform alternative to AirDrop'
+url="https://github.com/localsend/localsend"
+arch=('x86_64')
+options=('!debug' '!lto')
+source=("$pkgname::git+$url#tag=v$pkgver")
+sha256sums=('cc9535a1887593545d2a53111067493394545752f64d1ba3da2d40b58bcd9eab')
+
+makedepends=(git rust cargo base-devel)
+
+build() {
+        cd "$pkgname"
+        cargo build --release --workspace -j`nproc 2>/dev/null || getconf _NPROCESSORS_CONF`
+}
+
+package() {
+        cd "$pkgname"
+        install -Dm755 -t "$pkgdir/usr/local/bin/" target/release/localsend-cli 
+        ln -sf "$pkgdir/usr/local/bin/localsend-cli" "$pkgdir/usr/local/bin/lsend"
+        install -Dm755 -t "$pkgdir/usr/local/bin/" target/release/server 
+        install -Dm755 -t "$pkgdir/usr/local/lib/" target/release/librust_lib_localsend_app.* 
+}
diff --git a/nix/pkgs/lsend/nix/.gitignore b/nix/pkgs/lsend/nix/.gitignore
